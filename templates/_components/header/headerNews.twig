{% import '_macros/macroPostDate' as macroPostDate %}
{% import '_macros/macroCatOverview' as macroCat %}

{% set smallerGrid = 'gridStart2 gridSpan10' %}

<header class="headerCard newsHeadCard gridArticle headerSection{{ entry.section.handle | capitalize }}">
	<div class="{{ smallerGrid }} headMeta">
		{{ macroPostDate.postDate(entry.postDate, true) }}
	</div>

	<h1 class="{{ smallerGrid }} topicTitle">{{ entry.title }}</h1>
	{% if entry.fPlainTextI18nMultiline %}
		<h3 class="{{ smallerGrid }} topicLead">{{ entry.fPlainTextI18nMultiline }}</h3>
	{% endif %}
	<div class="headMetaFooter {{ smallerGrid }}">
		<p class="tags">
			{{ macroCat.catOverview(entry.fCatSubject, 'subject', entry.section) }}
		</p>
	</div>
</header>