{% import '_macros/macroPostDate' as macroPostDate %}
{% import '_components/previewCards/macroPreviewNews' as macroPreviewNews %}


{% set furtherNews = craft.entries
    .section('news')
    .id(['not', entry.id])
    .limit(5)
    .all()
%}

{# Output the links #}
{% for item in furtherNews %}
    {% if loop.first %}
		<h2 class="gridSpan12 moreArticlesTitle">{{ 'Vielleicht Interessiert Sie auch' | t }}</h2>
	{% endif %}
    {{ macroPreviewNews.listMacro(item,'gridSpan12','gridSpan12 gridSmSpan4 gridLgSpan4','gridSpan12 gridSmSpan8 gridLgSpan8') }}
{% endfor %}