{# Get the first genre from the current article #}
{% set relatedSubject = entry.fCatSubject.one() %}

{# Get Erste Hilfe entries matching the current genre #}
{% set ctaItems = craft.entries()
    .section('ersteHilfe')
    .relatedTo({
        targetElement: relatedSubject,
        field: 'fCatSubjectDisplay'
    })
    .all()
%}

{# Shuffle matching entries #}
{% set shuffledHilfe = shuffle(ctaItems) %}

{# Output only one random entry #}
{% set randomHilfe = shuffledHilfe|first %}

{% if randomHilfe %}
    <aside class="ersteHilfe" {% if randomHilfe.fColor %}style="background-color:{{ randomHilfe.fColor }}"{% endif %}>
        <h2 class="theTitle">{{ randomHilfe.title }}</h2>
        {% if randomHilfe.fPlainTextI18nMultiline %}
            <h3 class="theClaim">{{ randomHilfe.fPlainTextI18nMultiline }}</h3>
        {% endif %}
        {% if randomHilfe.fRichTextI18n %}
            <div class="theText">{{ randomHilfe.fRichTextI18n }}</div>
        {% endif %}
       <div class="theCta">
             {% if randomHilfe.fLinkI18n.type == 'email' %}
                {{ randomHilfe.fLinkI18n.link | enkode }}
            {% else %}
                {{ randomHilfe.fLinkI18n.link }}
            {% endif %}
       </div>
    </aside>
{% endif %}