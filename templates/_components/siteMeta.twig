<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">

  <link rel="preconnect" href="https://use.typekit.net">
  <link rel="preconnect" href="https://p.typekit.net" crossorigin>

  <link rel="preload" href="https://use.typekit.net/zfp0qhw.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://use.typekit.net/zfp0qhw.css"></noscript>
  
  <link rel="stylesheet" href="{{ craft.vite.entry('src/css/app.css') }}">

  

  {% set currentHandle = currentSite.handle %}
  {% set secondHandle = currentHandle == 'espacesuissePublishingFr' ? 'default' : 'espacesuissePublishingFr' %}
  {% set secondSite = craft.app.sites.getSiteByHandle(secondHandle) %}

<link rel="alternate" type="application/rss+xml" title="{{ currentSite.name }} ({{ currentSite.language|slice(0,2) }})" href="{{ currentSite.baseUrl }}feeds/feed-{{ currentSite.language|slice(0,2) }}.rss">
<link rel="alternate" type="application/rss+xml" title="{{ secondSite.name }} ({{ secondSite.language|slice(0,2) }})" href="{{ secondSite.baseUrl }}feeds/feed-{{ secondSite.language|slice(0,2) }}.rss">

<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="manifest" href="/site.webmanifest">

{% if entry is defined %}
  {% include "_components/openGraphAdditions.twig" %}
{% endif %}


{% include "_dynamic/unlockScript.twig" %}

  <script>
        // Check localStorage immediately before the browser renders the page
        const savedTheme = localStorage.getItem('theme') || 'auto';
        if (savedTheme !== 'auto') {
            document.documentElement.setAttribute('data-theme', savedTheme);
        }
    </script>

</head>