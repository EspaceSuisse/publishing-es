{% js %}
document.addEventListener('DOMContentLoaded', () => {
    const nav = document.querySelector('nav');

    document.querySelectorAll('.dropdownLink').forEach(button => {
        button.addEventListener('click', (event) => {
            event.preventDefault();

            const parentLi = button.closest('li');
            const dropdown = parentLi.querySelector('.dropdown');

            // Close any other open dropdowns
            document.querySelectorAll('.dropdown.open').forEach(openDropdown => {
                if (openDropdown !== dropdown) {
                    openDropdown.classList.remove('open');

                    const parentButton = openDropdown.closest('li').querySelector('.dropdownLink');
                    if (parentButton) {
                        parentButton.classList.remove('open');
                    }
                }
            });

            if (dropdown.classList.contains('open')) {
                dropdown.classList.add('closing');
                dropdown.classList.remove('open');
                button.classList.remove('open');

                setTimeout(() => {
                    dropdown.classList.remove('closing');

                    if (!document.querySelector('.dropdown.open')) {
                        nav.classList.remove('open');
                    }
                }, 300);
            } else {
                dropdown.classList.add('open');
                button.classList.add('open');
                nav.classList.add('open');
            }
        });
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (event) => {
        // Ignore clicks inside an open dropdown or on a dropdown trigger
        if (
            event.target.closest('.dropdown.open') ||
            event.target.closest('.dropdownLink')
        ) {
            return;
        }

        document.querySelectorAll('.dropdown.open').forEach(dropdown => {
            dropdown.classList.add('closing');
            dropdown.classList.remove('open');

            const button = dropdown.closest('li')?.querySelector('.dropdownLink');
            if (button) {
                button.classList.remove('open');
            }

            setTimeout(() => {
                dropdown.classList.remove('closing');

                if (!document.querySelector('.dropdown.open')) {
                    nav.classList.remove('open');
                }
            }, 300);
        });
    });
});
{% endjs %}