{% set moreLinks = globalLinks.mxSidebarLinks.all() %}

{% set currentSection = entry is defined and entry
    ? entry.section.handle
    : category is defined and category
        ? category.group.handle
        : author is defined and author
            ? author
            : null %}

{% for item in moreLinks %}
    {% set linkedEntry = item.fLinkI18n.getElement() %}
    {% set linkedSection = linkedEntry.section.handle ?? null %}
    {% set isActive = false %}

    {% if linkedSection and currentSection %}
        {% if linkedSection == 'allArticles' and currentSection == 'article' %}
            {% set isActive = true %}
        {% elseif linkedSection == 'listingNews' and currentSection == 'news' %}
            {% set isActive = true %}
        {% elseif linkedSection == 'listingAllSubjects' and currentSection == 'catSubject' %}
            {% set isActive = true %}
        {% elseif linkedSection == 'listingAllGenres' and currentSection == 'catGenre' %}
            {% set isActive = true %}
        {% elseif linkedSection == 'listingAuthor' and author is defined and author == 'authorPosts' %}
            {% set isActive = true %}
        {% else %}
            {% set isActive = currentSection == linkedSection %}
        {% endif %}
    {% endif %}

    {% if loop.first %}<ul>{% endif %}
    <li class="{{ isActive ? 'isActive' : '' }}">
        <a href="{{ item.fLinkI18n.url }}" aria-label="{{ item.fLinkI18n.label }}">
            {% for asset in linkedEntry.fIcon %}
                <span class="navIcon hideOnTablet">{{ svg(asset) }}</span>
            {% endfor %}
            {{ item.fLinkI18n.label }}
        </a>
    </li>
    {% if loop.last %}</ul>{% endif %}
{% endfor %}