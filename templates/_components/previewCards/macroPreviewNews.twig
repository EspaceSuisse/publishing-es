{% macro listMacro(queryParam, classCardParam, classImgParam, classTxtParam, hideImage, paramLazy = true) %}

	{% import '_macros/macroPostDate' as macroPostDate %}
	{% import '_macros/macroCatOverview' as macroCat %}
	{% import '_macros/macroImage' as macro %}


	{% set newsCat = queryParam.fCatSubject ?? null %}
	{% set image = queryParam.imgAufmacher[0] ?? null %}
	{% set noImg = image ? false : true %}

	<article class="previewCard previewArticle previewNews {{ classCardParam }} {% if not image %}hasNoImage{% endif %}">

		{% if image %}
		
			<a href="{{ queryParam.url }}" aria-label="{{ queryParam.title }}" class="imgPart {{ classImgParam }}">
				{{ macro.articleImage(image, 'articleThumb', 'previewImg') }}
			</a>

		{% endif %}

		<div class="txtPart {{ classTxtParam }}">
			<div class="txtOverview">
				<div class="previewMetaHeader">
					{{ macroPostDate.postDate(queryParam.postDate, true) }}
					{# {{ macroCat.catOverview(newsCat, 'subject', 'news', siteBrand.fColor2) }} #}
				</div>
				<h4 class="previewTitle">
					<a href="{{ queryParam.url }}">{{ queryParam.title }}</a>
				</h4>
				<p class="lead">{{ queryParam.fSeoDescription}}</p>
			</div>
			<a href="{{ queryParam.url }}" class="btn btnReadMore">{{ 'Lesen' | t }}</a>
		</div>
	</article>
	
{% endmacro %}
