<nav class="desktopNavi hideOnTablet">
	{% include "_components/sideBar/siteNavMoreLinks.twig" %}
	<ul class="langSwitcher">
		{% include "_components/sideBar/navLangSwitcher.twig" %}
		<li>
			<button popovertarget="settings">
				<span class="navIcon">{{ svg('@webroot/theme/img/icon-theme.svg') }}</span>
			</button>
		</li>
	</ul>
</nav>

<dialog id="settings" class="dialogSetting" popover>
	<p>This dialog was opened using an invoker command.</p>
	<ul>{% include "_components/themeColorSwitcher" %}</ul>
	<button popovertarget="settings" popovertargetaction="hide">Close</button>
</dialog>
