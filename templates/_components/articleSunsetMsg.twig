{% set accessMessage %}

    {% set memberLoginPage = craft.entries.section('memberLogin').one() %}
    {% set currentUser = craft.app.user.identity %}

    {% if freeForAll == true %}
        {{ 'Artikel frei Verfügbar' | t }}
    {% elseif currentUser %}
         {{ 'Artikel für Sie Verfügbar' | t }}
    {% elseif not isSunset  %}
        {{ 'Noch' | t }} {{ daysLeft }} {{ 'Tage verfügbar.' | t }}.
        <a href="https://www.espacesuisse.ch/de/verband/mitglieder">{{ 'Mitglied werden' | t }}</a>
    
    {% else %}
        {{ 'Für Mitglieder verfügbar' | t }}.
        <a href="{{ url( memberLoginPage.url , { redirect: craft.app.request.url }) }}">{{ 'Loggen Sie sich ein' | t }}</a>.
        <a href="https://www.espacesuisse.ch/de/verband/mitglieder">{{ 'Werden Sie Mitglied' | t }}</a>
    {% endif %}
{% endset %}

<p class="accessMessage">{{ accessMessage|raw }}</p>