
{% extends "_layouts/main" %}

{% block content %}

{# Search uses the rawsearch plugin: https://github.com/oncode/craft-rawsearch #}

    <article>
        <header class="pageHead subPageHead">
            {% include "_components/header/headerBrand" %}
            {% include "_components/header/headerPage" %}
        </header>

        <div class="gridArticle articleContent">
            {% include "_components/articleMatrix" %}
        </div>
    </article>

    {% set query = craft.app.request.getParam('query')|trim %}

    <article>
        <div class="gridArticle articleContent">
            <form
                action="{{ url(craft.app.request.pathInfo) }}"
                method="get"
                class="searchForm gridSpan10 gridStart2"
                id="search-form"
            >
                <input
                    type="search"
                    name="query"
                    value="{{ query }}"
                    id="search-input"
                    placeholder="{{ 'Suchen'|t }}…"
                    autocomplete="off"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-expanded="false"
                    aria-controls="search-suggestions"
                >

                <button type="submit" class="btn">
                    {{ 'Suchen'|t }}
                </button>

                <div
                    id="search-suggestions"
                    data-endpoint="{{ actionUrl('rawsearch/api/autocomplete') }}"
                    data-site="{{ currentSite.handle }}"
                    hidden
                ></div>
            </form>
        </div>

        <div class="gridArticle articleContent">
            <div class="searchResults gridSpan10 gridStart2">

                {% if query|length > 2 %}

                    {% set search = craft.rawSearch.search({
                        query: query,
                        site: currentSite.handle,
                        resultsPerPage: 10,
                        extract: {
                            type: 'sentences',
                            maxLength: 200
                        }
                    }) %}

                    {% if search.total %}
                        <div class="gridSpan10 resultsInTotal">
                            {{ craft.rawSearch.renderResults(search, query) }}
                        </div>

                    {% else %}
						<div class="gridSpan10 resultsInTotal">
							<p>
								{{ 'Für die Suche'|t }}
								“{{ query }}”
								{{ 'konnten wir leider nichts finden'|t }} :(
							</p>
						</div>
                    {% endif %}

                {% elseif query %}
                    <div class="gridSpan10 resultsInTotal">
						<p>
                        	{{ 'Bitte mindestens 3 Zeichen eingeben.'|t }}
                    	</p>
					</div>

                {% endif %}

            </div>
        </div>
    </article>

    {% js %}
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('search-form');
            const input = document.getElementById('search-input');
            const container = document.getElementById('search-suggestions');

            if (!form || !input || !container) return;

            let debounceTimer;
            let abortController;
            let activeIndex = -1;

            const closeSuggestions = () => {
                container.hidden = true;
                container.innerHTML = '';
                input.setAttribute('aria-expanded', 'false');
                input.removeAttribute('aria-activedescendant');
                activeIndex = -1;
            };

            const getSuggestions = async () => {
                const query = input.value.trim();

                if (query.length < 2) {
                    closeSuggestions();
                    return;
                }

                if (abortController) {
                    abortController.abort();
                }

                abortController = new AbortController();

                const url = new URL(
                    container.dataset.endpoint,
                    window.location.origin
                );

                url.searchParams.set('query', query);
                url.searchParams.set('site', container.dataset.site);
                url.searchParams.set('limit', '8');

                try {
                    const response = await fetch(url, {
                        signal: abortController.signal,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        throw new Error('Autocomplete request failed');
                    }

                    const data = await response.json();

                    if (input.value.trim() !== query) return;

                    if (data.error || !data.result?.length) {
                        closeSuggestions();
                        return;
                    }

                    container.innerHTML = '';

                    const list = document.createElement('ul');
                    list.className = 'searchSuggestions';

                    data.result.forEach((word, index) => {
                        const item = document.createElement('li');
                        item.id = `suggestion-${index}`;
                        item.setAttribute('role', 'option');
                        item.setAttribute('aria-selected', 'false');

                        const link = document.createElement('a');
                        const targetUrl = new URL(
                            form.action,
                            window.location.origin
                        );

                        targetUrl.searchParams.set('query', word.word);
                        link.href = targetUrl.toString();
                        link.textContent = word.word;

                        const count = document.createElement('span');
                        count.className = 'suggestionCount';
                        count.textContent = ` (${word.results})`;

                        link.appendChild(count);
                        item.appendChild(link);
                        list.appendChild(item);
                    });

                    container.appendChild(list);
                    container.hidden = false;
                    input.setAttribute('aria-expanded', 'true');
                    activeIndex = -1;

                } catch (error) {
                    if (error.name !== 'AbortError') {
                        console.error(error);
                    }
                }
            };

            input.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(getSuggestions, 250);
            });

            input.addEventListener('keydown', event => {
                const suggestions = container.querySelectorAll('[role="option"]');

                if (!suggestions.length || container.hidden) return;

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    activeIndex = (activeIndex + 1) % suggestions.length;
                }

                else if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    activeIndex = activeIndex <= 0
                        ? suggestions.length - 1
                        : activeIndex - 1;
                }

                else if (event.key === 'Escape') {
                    closeSuggestions();
                    return;
                }

                else if (event.key === 'Enter' && activeIndex >= 0) {
                    event.preventDefault();
                    suggestions[activeIndex].querySelector('a').click();
                    return;
                }

                suggestions.forEach((suggestion, index) => {
                    const active = index === activeIndex;

                    suggestion.setAttribute('aria-selected', active);

                    if (active) {
                        input.setAttribute(
                            'aria-activedescendant',
                            suggestion.id
                        );
                    }
                });
            });

            document.addEventListener('click', event => {
                if (!form.contains(event.target)) {
                    closeSuggestions();
                }
            });

            form.addEventListener('submit', closeSuggestions);
        });
    {% endjs %}

    {% css %}
        #search-form {
            position: relative;
        }

        #search-suggestions {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 10;
            background: white;
            border: 1px solid #ccc;
        }

        #search-suggestions[hidden] {
            display: none;
        }

        .searchSuggestions {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .searchSuggestions li a {
            display: block;
            padding: 10px 15px;
            text-decoration: none;
        }

        .searchSuggestions li[aria-selected="true"] a,
        .searchSuggestions li a:hover {
            background: #eee;
        }

        .suggestionCount {
            opacity: .6;
        }
    {% endcss %}

{% endblock %}
