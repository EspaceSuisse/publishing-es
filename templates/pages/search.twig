
{% extends "_layouts/main" %}

{% block content %}


		<article>
			<header class="pageHead subPageHead">
				{% include "_components/header/headerBrand" %}
				{% include "_components/header/headerPage" %}
			</header>
			<div class="gridArticle articleContent">
				{% include "_components/articleMatrix" %}
			</div>
		</article>

		{% set query = craft.app.request.getQueryParam('query') %}

		<article>
			<div class="gridArticle articleContent">
				<form class="searchForm gridSpan6 gridStart4" id="search-form">
					<input
						type="search"
						name="query"
						value="{{ query }}"
						id="search-input"
						placeholder="{{ 'Suchen'|t }}…"
						autocomplete="off"
						role="combobox"
						aria-autocomplete="list"
						aria-expanded="false"
						aria-controls="search-suggestions"
					>

					<button type="submit" class="btn">{{ 'Suchen'|t }}</button>

					<div
						id="search-suggestions"
						data-endpoint="{{ url('search-suggestions') }}"
						hidden
					></div>
				</form>
			</div>

			<div class="gridArticle articleContent">
				<div class="searchResults gridSpan10 gridStart2">

					{% if query %}
						{% set results = craft.entries()
							.section('*')
							.search(query)
							.orderBy('score')
							.all() %}

						{% if results is not empty %}
							<p class="gridSpan10 foundTotalResults">
								{{ results|length }} {{ 'Einträge gefunden.'|t }}
							</p>

							<ul class="searchResultList">
								{% for result in results %}
									<li>
										<h2>{{ result.getLink() }}</h2>
									</li>
								{% endfor %}
							</ul>
						{% else %}
							<p class="gridSpan10 gridStart2 foundTotalResults">
								{{ 'Für die Suche'|t }} “{{ query }}” {{ 'konnten wir leider nichts finden'|t }}!
							</p>
						{% endif %}
					{% endif %}

				</div>
			</div>
		</article>

		{% js %}
			document.addEventListener('DOMContentLoaded', () => {

				const form = document.getElementById('search-form');
				const input = document.getElementById('search-input');
				const container = document.getElementById('search-suggestions');

				if (!form || !input || !container) return;

				let debounceTimer;
				let abortController;
				let activeIndex = -1;

				const closeSuggestions = () => {
					container.hidden = true;
					container.innerHTML = '';
					input.setAttribute('aria-expanded', 'false');
					input.removeAttribute('aria-activedescendant');
					activeIndex = -1;
				};

				const getSuggestions = () => {
					const query = input.value.trim();

					if (query.length < 2) {
						closeSuggestions();
						return;
					}

					// Cancel any previous request.
					if (abortController) {
						abortController.abort();
					}

					abortController = new AbortController();

					const url = new URL(container.dataset.endpoint, window.location.origin);
					url.searchParams.set('query', query);

					console.log('Autocomplete request:', url.toString());

					fetch(url, {
						signal: abortController.signal,
						headers: {
							'X-Requested-With': 'XMLHttpRequest'
						}
					})
					.then(response => {
						if (!response.ok) throw new Error('Search request failed');
						return response.text();
					})
					.then(html => {
							console.log('Autocomplete response:', html);

							if (input.value.trim() !== query) return;

							container.innerHTML = html;

							const suggestions = container.querySelectorAll('[role="option"]');

							console.log('Suggestions found:', suggestions.length);

							if (!suggestions.length) {
								closeSuggestions();
								return;
							}

							container.hidden = false;
							input.setAttribute('aria-expanded', 'true');
							activeIndex = -1;
					})
					.catch(error => {
						if (error.name !== 'AbortError') {
							console.error(error);
						}
					});
				};

				input.addEventListener('input', () => {
					clearTimeout(debounceTimer);

					debounceTimer = setTimeout(getSuggestions, 250);
				});

				input.addEventListener('keydown', event => {
					const suggestions = container.querySelectorAll('[role="option"]');

					if (!suggestions.length || container.hidden) return;

					if (event.key === 'ArrowDown') {
						event.preventDefault();
						activeIndex = (activeIndex + 1) % suggestions.length;
					}

					else if (event.key === 'ArrowUp') {
						event.preventDefault();
						activeIndex = activeIndex <= 0
							? suggestions.length - 1
							: activeIndex - 1;
					}

					else if (event.key === 'Escape') {
						closeSuggestions();
						return;
					}

					else if (event.key === 'Enter' && activeIndex >= 0) {
						event.preventDefault();
						suggestions[activeIndex].querySelector('a').click();
						return;
					}

					suggestions.forEach((suggestion, index) => {
						const active = index === activeIndex;

						suggestion.setAttribute('aria-selected', active);

						if (active) {
							input.setAttribute('aria-activedescendant', suggestion.id);
						}
					});
				});

				// Close when clicking outside the search form.
				document.addEventListener('click', event => {
					if (!form.contains(event.target)) {
						closeSuggestions();
					}
				});

				// Close suggestions when submitting the regular search form.
				form.addEventListener('submit', closeSuggestions);

			});
		{% endjs %}

	{% css %}

		#search-form {
			position: relative;
		}

		#search-suggestions {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			z-index: 10;
			background: white;
			border: 1px solid #ccc;
		}

		#search-suggestions[hidden] {
			display: none;
		}

		.searchSuggestions {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.searchSuggestions li a {
			display: block;
			padding: 10px 15px;
			text-decoration: none;
		}

		.searchSuggestions li[aria-selected="true"] a,
		.searchSuggestions li a:hover {
			background: #eee;
		}

	{% endcss %}

{% endblock %}
