{% extends "_layouts/main" %}
{% import '_macros/macroImage' as macroImg %}
{% import '_macros/macroAuthorField' as macro %}
{% import '_macros/macroPostDate' as macroPostDate %}
{% import '_macros/macroAuthorFull' as writers %}
{% import '_macros/macroAuthorTaxonomy' as authorTaxonomy %}

{% block content %}

	{# get all relevant authors #}
	{% set authorPosts = craft.users
        .group(['espacesuisse'])
		.fSwitchOn(true)
        .orderBy('fullName asc')
        .status('active')
        .all() %}

	{% set authorGuest = craft.users
        .group(['externalAuthor'])
		.fSwitchOn(true)
        .orderBy('fullName asc')
        .status('active')
        .all() %}

	{# construct the language url segment becuse users have no urls functionality #}
	{% set baseSegment = { 'de-CH': 'autoren', 'fr-CH': 'auteurs' }[craft.app.language] %}

	<header class="pageHead subPageHead">
		{% include "_components/header/headerBrand" %}
		{% include "_components/header/headerPage" %}
	</header>
	<article class="listingGrid">
		{% for author in authorPosts %}

			{# cconstruct the link to the authors page with all his written articles #}
			{% set authorPostPage = craft.entries.section('article').authorId(author.id).limit(1).one() %}

			{# construct the author slug. unfortunately umlauts are unavoidable right now #}
			{% set authorSlug = author.username %}

			{# construct the url to the authors post page #}
			{% set authorPostsUrl = url(baseSegment ~ '/' ~ authorSlug) %}


			{% if authorPostPage %}
				<div class="authorCard gridSpan12 gridLgSpan4 previewCard">
					{# render author photo #}
					<a href="{{ authorPostsUrl}}" class="imgPart gridSpan12 gridSmSpan4">
						{% if author.photo %}
							{{ macroImg.articleImage(author.photo, 'articleImage', 'imgArticle') }}
						{% endif %}
					</a>
					<div class="txtPart gridSpan12 gridSmSpan8">
						<h2 class="authorName">{{ author.name }}</h2>
						<p class="authorTaxonomy">{{ authorTaxonomy.authorTaxonomy(author) }}</p>
						<a href="{{ authorPostsUrl }}" class="btn btnReadMore">
							{{ 'Zu den Artikeln' | t }}
						</a>
					</div>
				</div>
			{% endif %}

		{% endfor %}

		{% if authorGuest | length %}
			<div class="geustAuthors gridSpan12">
				<h2 class="topicTitle">{{ 'Unsere Gastautoren' | t }}</h2>
				<ul class="guestAuthorList">
					{% for guest in authorGuest %}
						<li>{{ guest.fullName }}</li>
					{% endfor %}
				</ul>
			</div>
		{% endif %}
	</article>

{% endblock %}
