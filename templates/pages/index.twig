{% extends "_layouts/main" %}

{% import '_components/previewCards/macroPreviewArticle' as macroPreview %}
{% import '_macros/macroCatOverview' as macroCat %}

{% block content %}
	{% set catGenre = craft.categories()
		.group('catGenre')
		.relatedTo({ sourceElement: articleIds })
		.all()
	%}

	{% set catSubject = craft.categories()
		.group('catSubject')
		.relatedTo({ sourceElement: articleIds })
		.all()
	%}

	{% set allEntries = craft.entries()
		.section('article')
		.with(articleEagerLoad)
		.orderBy('sticky desc, postDate desc')
		.limit(null)
		.all()
	%}

	{% set goToAllNews = craft.entries.section('listingNews').one() %}

	{# --- Layout config --- #}
	{% set sliceA = 1 %}
	{% set sliceB = 6 %}
	{% set sliceC = 4 %}
	{% set sliceD = 4 %}
	{% set sliceE = 6 %}

	{# Initialize a single offset variable to 0 #}
	{% set currentOffset = 0 %}

	<div class="listingGrid listingSection">
		{% include "_components/header/headerBrand" %}
		{# Block A #}
		{% for item in allEntries | slice(currentOffset, sliceA) %}
			{{ macroPreview.listMacro(item,'gridSpan12 gridLgSpan8',' gridSpan12','gridSpan12 gridLgSpan8', false, false) }}
		{% endfor %}
		{# Update offset for the next block #}
		{% set currentOffset = currentOffset + sliceA %}

		{% include "_components/newsTicker" %}
		
		{# Block B #}
		{% for item in allEntries | slice(currentOffset, sliceB) %}
			{{ macroPreview.listMacro(item,'gridSpan12 gridLgSpan4','gridSpan12 gridSmSpan4','gridSpan12 gridSmSpan8 gridLgSpan4') }}
		{% endfor %}
		{% set currentOffset = currentOffset + sliceB %}
	</div>

	{% include "_components/listingSuperTopic" %}
	{% include "_components/listingCatList" %}

	<div class="listingGrid listingSection">
		{# Block C #}
		{% for item in allEntries | slice(currentOffset, sliceC) %}
			{{ macroPreview.listMacro(item,'gridSpan12 gridMdSpan6 gridMdSpan4','gridSpanFull','gridSpanFull') }}
		{% endfor %}
		{% set currentOffset = currentOffset + sliceC %}
	</div>

	<div class="listingGrid listingSection">
		{# Block D (Your new block) #}
		{% for item in allEntries | slice(currentOffset, sliceD) %}
			{{ macroPreview.listMacro(item,'gridSpan12',' gridSpan12 gridMdSpan4','gridSpan12 gridMdSpan8') }}
		{% endfor %}
		{% set currentOffset = currentOffset + sliceD %}
	</div>

	<div class="listingGrid listingSection">
		{# Block E (Your new block) #}
		{% for item in allEntries | slice(currentOffset, sliceE) %}
			{{ macroPreview.listMacro(item,'gridSpan12 gridLgSpan4','gridSpan12 gridSmSpan4','gridSpan12 gridSmSpan8 gridLgSpan4') }}
		{% endfor %}
		{% set currentOffset = currentOffset + sliceE %}
	</div>

	{# Example of a final "catch-all" block for the rest of the entries #}
	<div class="listingGrid listingSection">
		{# Notice there is no second argument here, so it gets everything remaining #}
		{% for item in allEntries | slice(currentOffset) %}
			{{ macroPreview.listMacro(item,'gridSpan12',' gridSpan12 gridMdSpan4','gridSpan12 gridMdSpan8') }}
		{% endfor %}
	</div>

	
{% endblock %}
