{% extends "_layouts/main" %}

{% import '_components/previewCards/macroPreviewArticle' as macroPreviewArticle %}
{% import '_components/previewCards/macroPreviewNews' as macroPreviewNews %}

{% block content %}

	{# Check if the URL contains ?section=... (strictly from query string) #}
	{% set sectionFilter = craft.app.request.getQueryParam('section') %}
	{% set pageTitle = category.title %}

	{# Redirect 302 to clean category URL if ?section= is used on catGenre or has an invalid value #}
	{% if sectionFilter is not null and (
		category.group.handle != 'catSubject' or sectionFilter not in ['article', 'news']
	) %}
		{% redirect category.url 302 %}
	{% endif %}

	{# Build the entry query #}
	{% set query = craft.entries()
		.relatedTo(category)
		.with(['fCatGenre', 'fCatSubject'])
		.orderBy('sticky desc, postDate desc')
		.limit(null)
	%}

	{% if sectionFilter %}
		{% set query = query.section(sectionFilter) %}
	{% endif %}

	{% set allEntries = query.all() %}

	{# Handle empty results #}
	{% if allEntries is empty %}
		{% if sectionFilter %}
			{# Valid filter param, but 0 entries in this section -> 302 back to base category URL #}
			{% redirect category.url 302 %}
		{% else %}
			{# Unassigned category (0 entries overall) -> 404 so we don't redirect to ourselves #}
			{% exit 404 %}
		{% endif %}
	{% endif %}

	{# Update pageTitle and SEOmatic metadata when a valid section filter is active #}
	{% if sectionFilter %}
		{% set sectionTitle = sectionFilter == 'article' ? labelArticle : labelNews %}
		{%- set pageTitle = 'Alle'|t ~ ' ' ~ sectionTitle ~ ' – ' ~ category.title -%}
		{% include "_components/catSectionFilter" %}
	{% endif %}

	{# --- Layout config --- #}
	{% set sliceA = 1 %}
	{% set sliceB = 2 %}
	{% set sliceC = 4 %}

	{# Offsets calculate themselves #}
	{% set offsetB = sliceA %} {# Equals 1 #}
	{% set offsetC = sliceA + sliceB %} {# Equals 3 #}
	{% set offsetD = sliceA + sliceB + sliceC %} {# Equals 7 #}

	{# Display All Subject Category in Use. Unassigned Items will not be displayed #}
	<article class="listingGrid">
		
		{% include "_components/header/headerBrand" %}
		{% if category.group.handle == 'catSubject' %}
			{% include "_components/header/headerCatList" %}
		{% endif %}
        
		{# First block: 1 Item #}
		{% for item in allEntries | slice(0, sliceA) %}

			{% set macroParams = [ 'gridSpan12', 'gridSpan12 gridMdSpan4 gridLgSpan7', 'gridSpan12 gridMdSpan8 gridLgSpan5' ] %}

			{% if item.section.handle == 'news' %}
				{{ macroPreviewNews.listMacro(item, ...macroParams) }}
			{% else %}
				{{ macroPreviewArticle.listMacro(item, ...macroParams) }}
			{% endif %}
		{% endfor %}
        
		{# Second block: 2 Items #}
		{% for item in allEntries | slice(offsetB, sliceB) %}

			{% set macroParams = ['gridSpan12 gridMdSpan6', 'gridSpan12', 'gridSpan12 gridMdSpan6'] %}

			{% if item.section.handle == 'news' %}
				{{ macroPreviewNews.listMacro(item, ...macroParams) }}
			{% else %}
				{{ macroPreviewArticle.listMacro(item, ...macroParams) }}
			{% endif %}
		{% endfor %}

		{# MISSING THIRD BLOCK ADDED HERE: 4 Items #}
		{% for item in allEntries | slice(offsetC, sliceC) %}

			{% set macroParams = ['gridSpan12 gridMdSpan6', 'gridSpan12', 'gridSpan12 gridMdSpan6'] %}

			{% if item.section.handle == 'news' %}
				{{ macroPreviewNews.listMacro(item, ...macroParams) }} {# Adjust these classes as needed #}
			{% else %}
				{{ macroPreviewArticle.listMacro(item, ...macroParams) }} {# Adjust these classes as needed #}
			{% endif %}
		{% endfor %}

		{# Fourth block: Remaining Items #}
		{% for item in allEntries | slice(offsetD) %}

			{% set macroParams = ['gridSpan12 gridMdSpan4', 'gridSpan12', 'gridSpan12 gridMdSpan4'] %}

			{% if item.section.handle == 'news' %}
				{{ macroPreviewNews.listMacro(item, ...macroParams) }}
			{% else %}
				{{ macroPreviewArticle.listMacro(item, ...macroParams) }}
			{% endif %}
		{% endfor %}
	</article>

{% endblock %}
