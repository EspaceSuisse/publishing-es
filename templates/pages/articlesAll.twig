{% extends "_layouts/main" %}

{% import '_components/previewCards/macroPreviewArticle' as macroPreview %}

{% block content %}

	{% set allArticles = craft.entries()
		.section('article')
		.orderBy('sticky desc, postDate desc')
		.limit(null)
	%}

		{# --- Layout config --- #}
	{% set sliceA = 1 %}
	{% set sliceB = 2 %}
	{% set sliceC = 4 %}
	{% set sliceD = 4 %}

	{# Offsets calculate themselves #}
	{% set currentOffset = 0 %}
	
	{% paginate allArticles as pageInfo, newsEntries %}

	<header class="pageHead subPageHead">
		{% include "_components/header/headerBrand" %}
		{% include "_components/header/headerPage" %}
	</header>
	{# Display All Subject Category in Use. Unassigned Items will not be displayed #}
	<article class="listingGrid">
        
		{# First block: 1 Item #}
		{% for item in allArticles | slice(currentOffset, sliceA) %}

			{% set macroParams = [ 'gridSpan12', 'gridSpan12 gridMdSpan4 gridLgSpan7', 'gridSpan12 gridMdSpan8 gridLgSpan5' ] %}
			{{ macroPreview.listMacro(item, ...macroParams) }}
			{% set currentOffset = currentOffset + sliceA %}
		{% endfor %}
        
		{# Second block: 2 Items #}
		{% for item in allArticles | slice(currentOffset, sliceB) %}

			{% set macroParams = ['gridSpan12 gridMdSpan6', 'gridSpan12', 'gridSpan12 gridMdSpan6'] %}

			{{ macroPreview.listMacro(item, ...macroParams) }}
			{% set currentOffset = currentOffset + sliceB %}
		{% endfor %}

		{# MISSING THIRD BLOCK ADDED HERE: 4 Items #}
		{% for item in allArticles | slice(currentOffset, sliceC) %}

			{% set macroParams = ['gridSpan12 gridMdSpan6', 'gridSpan12', 'gridSpan12 gridMdSpan6'] %}

			{{ macroPreview.listMacro(item, ...macroParams) }}
			{% set currentOffset = currentOffset + sliceC %}
		{% endfor %}

		{# Fourth block: Remaining Items #}
		{% for item in allArticles | slice(currentOffset) %}

			{% set macroParams = ['gridSpan12 gridMdSpan4', 'gridSpan12', 'gridSpan12 gridMdSpan4'] %}

			{{ macroPreview.listMacro(item, ...macroParams) }}
		{% endfor %}
	</article>
	
{% endblock %}
