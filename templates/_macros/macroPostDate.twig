{% macro postDate(date, wrap = false) %}
    {% if wrap %}<p class="postDate">{% endif %}

    {% set daysAgo = date.diff(now).days %}

    {% if daysAgo == 0 %}
        {{ 'Heute' | t }}
    {% elseif daysAgo == 1 %}
        {{ 'Gestern' | t }}
    {% elseif daysAgo == 2 %}
        {{ 'Vorgestern' | t }}
    {% else %}
        {{ date|timestamp }}
    {% endif %}

    {% if wrap %}</p>{% endif %}
{% endmacro %}