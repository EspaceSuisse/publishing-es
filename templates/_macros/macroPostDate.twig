{% macro postDate(date, wrap = false) %}
    {% if wrap %}<p class="postDate">{% endif %}

    {% set daysAgo = date.diff(now).days %}

    {% if daysAgo == 0 %}
        {{ 'Heute' | t }}
    {% elseif daysAgo == 1 %}
        {{ 'Gestern' | t }}
    {% else %}
        {% if craft.app.language == 'de-CH' %}
            {{ date | date('d. M Y') }}
        {% else %}
            {{ date | date('d M Y') }}
        {% endif %}
    {% endif %}
    {% if wrap %}</p>{% endif %}
{% endmacro %}