{%- macro authorArticle(queryParam, htmlParam) -%}

		{% import '_macros/macroAuthorUrl' as authorUrlHelper %}
		{% import '_macros/macroAuthorTaxonomy' as authorTaxonomy %}

		{% set writter = queryParam %}

		{% if htmlParam %}<li class="authorItem">{% endif %}
		
		
			{%- if writter.photo -%}

				{# Transform the Authors Portrait #}
    			{%- set portraitImage = craft.imagerx.transformImage(writter.photo, 'authorPortrait')[0] -%}

				<img src="{{ portraitImage.url }}" alt="{{ writter.name }}">
			{%- endif -%}
				<div>
					<p class="authorName">
						{% if writter.fSwitchOn %}
							<a href="{{ authorUrlHelper.url(writter) }}">{{ writter.name|replace({' ': '&nbsp;'})|raw }}</a>
						{% else %}
							{{ writter }}
						{% endif %}
					</p>
					<p class="authorMeta">
						{{ authorTaxonomy.authorTaxonomy(writter) }}
					</p>
				</div>
		{% if htmlParam %}</li>{% endif %}
{%- endmacro -%}