{%- macro imageSource(handleParam) -%}

	{%- set imgSource = handleParam.fmImgSource.all() -%}
	{%- set imgSourcePlatform = handleParam.fTagProvider.one() -%}
	{%- set imgSourceLicence = handleParam.fImgLicence.one() -%}
	{%- set imgSourceUrl = handleParam.imgSourceUrl -%}

	{%- set photographer = '' -%}
	{%- set totalSourceString = '' -%}

	

	{# Construct the Photographer Name #}
	{%- for item in imgSource -%}
		{%- switch item.type.handle -%}
			{%- case 'tMonolingual' -%}
				{%- set photographer = item.fPlainTxt -%}
			{%- case 'tMultilingual' -%}
				{%- set photographer = item.fPlainTextI18n -%}
		{%- endswitch -%}
	{%- endfor -%}

	{# Construct the source + Photographer + image licence #}

	{%- set totalSourceString = ' ' ~ photographer ~ ' ' ~ imgSourcePlatform ~ ' ' ~ imgSourceLicence -%}

	{% if imgSourceUrl %}
		({{ 'Quelle' | t }}: <a href="{{ imgSourceUrl }}" target="_blank">{{ totalSourceString | trim }}</a>)
	{% else %}
		({{ 'Quelle' | t }}: {{- totalSourceString | trim -}})
	{% endif %}

{%- endmacro -%}
