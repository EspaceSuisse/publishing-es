{%- set language = site.language -%}

{%- set feedEntries = customEntries ?? craft.entries()
    .section(['article', 'news'])
    .site(site)
    .orderBy('postDate desc')
    .limit(100)
    .all()
-%}

<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="/theme/rss-style.xsl"?>
<rss 
    version="2.0"
    xmlns:atom="http://www.w3.org/2005/Atom"
    xmlns:media="http://search.yahoo.com/mrss/"
    xmlns:custom="https://inforaum.ch/rss/custom"
    xmlns:content="http://purl.org/rss/1.0/modules/content/">

{% import '_macros/macroRssImg' as macroImg %}

<channel>
    <title>{{ siteBrand.fPlainTextI18n }} - {{ 'News & Artikel' | t }} ({{ language|slice(0,2) | upper }})</title>
    <link>{{ siteUrl(language) }}</link>
    <atom:link rel="self"  href="{{ siteUrl ~ 'feeds/feed-' ~ language |slice(0,2) }}.rss" />
    <description>{{ 'Neuste Artikel in' | t (language) ~ ' ' ~ language }}</description>
    <language>{{ language }}</language>
    <generator>Craft CMS</generator>

    {% set deSiteHandle = 'default' %}
    {% set frSiteHandle = 'espacesuissePublishingFr' %}
    

    {% for item in feedEntries %}

            {% if item.language == 'de-CH' %}
                {% set langISO = 'de' %}
                {% set itemPostDate = item.postDate %}
            {% else %}
                {% set langISO = 'fr' %}
                {% set itemPostDate = item.postDate | date_modify('+1 hour') %}
            {% endif %}

        {% set otherLang = craft.entries()
            .uid(item.uid)
            .site( item.site.handle == deSiteHandle ? frSiteHandle : deSiteHandle )
            .one()
        %}

        {% set textLength = 400 %}

        {% set feedItemTitle = item.fPlainTextI18n ?: item.title %}
        {% set feedLongText = item.fPlainTextI18nMultiline %}
        {% set feedItemLead = feedLongText | length > textLength ? feedLongText | slice(0, textLength) ~ '…': feedLongText %}
        {% set feedItemSeoDesc = item.fSeoDescription %}
        

        <item>
            {% if item.imgAufmacher | length %}
                {{ macroImg.rssFeedImg(item.imgAufmacher.one(), 'feedImageTransform') }}
            {% else %}
                {{ macroImg.rssFeedImg(seoDefaults.fImgI18n.one(), 'feedImageTransform') }}
            {% endif %}
            <pubDate>{{ itemPostDate | atom }} </pubDate>
            <title>{{ feedItemTitle }}</title>
            <description><![CDATA[{{ feedItemSeoDesc }}]]></description>
            <content:encoded><![CDATA[{{ feedItemLead }}]]></content:encoded>
            <link>{{ item.url }}</link>
            <guid isPermaLink="false">{{ item.uid }}-{{ item.siteId }}</guid>
            <source>{{ craft.app.request.absoluteUrl }}</source>
            <category domain="language">{{ langISO }}</category>
            {% if item.section.handle == 'article' %}
                {% for author in item.authors %}
                    <author>{{ author.name }}</author>
                {% endfor %}
            {% endif %}
            {% if item.fCatGenre %}
                {% for cat in item.fCatGenre.all() %}
                    <category domain="{{ cat.url }}">{{ cat.title }}</category>
                {% endfor %}
            {% endif %}
            {% if item.fCatSubject %}
                {% for cat in item.fCatSubject.all() %}
                    <category domain="{{ cat.url }}">{{ cat.title }}</category>
                {% endfor %}
            {% endif %}
            {%- if otherLang -%}
                <atom:link rel="alternate" hreflang="{{ otherLang.language }}" href="{{ otherLang.url }}" />
            {%- endif -%}
        </item>
    {% endfor %}
</channel>
</rss>