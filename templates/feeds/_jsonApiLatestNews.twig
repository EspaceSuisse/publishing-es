{% set latestNews = craft.entries.section('news').site(site).limit(3).all() %}
{% set language = site.language %}

[
{% for item in latestNews %}
    {
        "id": "{{ item.id }}",
        "title": "{{  item.fPlainTextI18n ??  item.title}}",
        "description": "{{ item.fSeoDescription }}",
        "url": "{{ item.url }}",
        "postDate": "{{ item.postDate | date('c') }}",
        "postDateUnix": {{ item.postDate | date('U') }},
        "item_uid": "{{ item.uid }}-{{ item.siteId }}",
        "es_type": "News",
        "es_thema": "Raumplanung",
        "language": "{{ language }}",
        "ir_categories": [
            {% for category in item.fCatSubject.all() %}
                {
                    "title": "{{ category.title }}"
                }{% if not loop.last %},{% endif %}
            {% endfor %}
            ]
    }{% if not loop.last %},{% endif %}
{% endfor %}
]